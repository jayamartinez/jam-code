          "role": "assistant",
          "createdAt": "2026-09-25T17:42:00.000Z",
          "blocks": [
            {
              "type": "text",
              "text": "The resource owns the content; each view owns only its position and focus. This demo keeps that distinction visible in both layouts."
            }
          ]
        }
